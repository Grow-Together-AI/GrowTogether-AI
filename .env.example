# Database
DATABASE_URL=

# Authentication (Auth.js v5 — canonical variable names)
AUTH_SECRET=
# AUTH_URL is usually auto-detected; only set it for non-standard hosting setups

# Email (optional in Development — leave blank to log emails to console)
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=

# File storage (optional in Development — leave blank to save locally)
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET_NAME=

# Multi-tenancy default
APP_ORGANIZATION_ID=

# Error monitoring (optional)
SENTRY_DSN=

# Security
RATE_LIMIT_ENABLED=true
SOFT_DELETE_GRACE_DAYS=30

# AI provider (Phase 2 only — leave blank for Phase 1)
AI_PROVIDER_API_KEY=
